root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{md,yml,yaml,json,jsonc}]
indent_size = 2

# Etch's canonical configuration format uses two spaces and a 120-column limit.
[*.conf]
indent_size = 2
max_line_length = 120
