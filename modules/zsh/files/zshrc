# Allow local customizations in the ~/.zshrc_before_local file
if [ -f "$HOME/.zshrc_before_local" ]; then
    source "$HOME/.zshrc_before_local"
fi

if [ -f "$HOME/.config/shell/environment.sh" ]; then
    . "$HOME/.config/shell/environment.sh"
fi

# Add Homebrew completions before Oh My Zsh runs compinit, including non-login shells.
if [ -n "${HOMEBREW_PREFIX:-}" ] && (( ! ${fpath[(Ie)$HOMEBREW_PREFIX/share/zsh/site-functions]} )); then
    fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# Path to your oh-my-zsh installation.
export ZSH=$HOME/.oh-my-zsh

# Set ZSH_THEME to blank so starship can load
ZSH_THEME=""
# Auto update oh-my-zsh automatically without asking
zstyle ':omz:update' mode auto

# Timestamp in history command output format
HIST_STAMPS="yyyy-mm-dd"

plugins=(
    git
    zsh-autosuggestions
    zsh-completions
    zsh-syntax-highlighting
)

if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# User configuration

# Control f goes forward a word
bindkey "^f" forward-word
# Control g deletes a word
bindkey "^g" backward-word

zstyle ':completion:*' menu select

# Initialize starship for zsh when installed
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"

    # Match Zsh's multiline continuation prompt to the Starship input prompt,
    # omitting the angled terminator so continued input remains aligned.
    PS2='%K{#b4befe}%F{#11111b} ❯ %k%f  '
fi

# Allow local customizations in the ~/.zshrc_after_local file
if [ -f "$HOME/.zshrc_after_local" ]; then
    source "$HOME/.zshrc_after_local"
fi
