# Allow machine-local overrides without tracking them in the repository.
if [ -f "$HOME/.bashrc_before_local" ]; then
    . "$HOME/.bashrc_before_local"
fi

case $- in
    *i*) ;;
    *) return ;;
esac

if [ -f "$HOME/.config/shell/environment.sh" ]; then
    . "$HOME/.config/shell/environment.sh"
fi

export OSH="$HOME/.local/share/oh-my-bash"
# Starship owns the prompt; the framework supplies Git aliases and completions.
OSH_THEME=""
HIST_STAMPS="yyyy-mm-dd"
# Match Oh My Zsh: update automatically without an interactive confirmation.
DISABLE_UPDATE_PROMPT=true
completions=(git ssh)
aliases=()
plugins=(git)
if [ -f "$OSH/oh-my-bash.sh" ]; then
    . "$OSH/oh-my-bash.sh"
fi

unset MAILCHECK
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if [ -f "$HOME/.bashrc_after_local" ]; then
    . "$HOME/.bashrc_after_local"
fi
