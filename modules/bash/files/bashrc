# Allow machine-local overrides without tracking them in the repository.
if [ -f "$HOME/.bashrc_before_local" ]; then
    source "$HOME/.bashrc_before_local"
fi

case $- in
    *i*) ;;
    *) return ;;
esac
# Let the login profile avoid sourcing this twice if a distro's ~/.profile loads it.
_DOTFILES_BASHRC_LOADED=1

if [ -f "$HOME/.config/shell/environment.sh" ]; then
    source "$HOME/.config/shell/environment.sh"
fi

export OSH="$HOME/.oh-my-bash"
# Starship owns the prompt; the framework supplies Git aliases and completions.
OSH_THEME=""
HIST_STAMPS="yyyy-mm-dd"
# Match Oh My Zsh: update automatically without an interactive confirmation.
DISABLE_UPDATE_PROMPT=true
completions=(git ssh)
aliases=()
plugins=(git)
if [ -f "$OSH/oh-my-bash.sh" ]; then
    source "$OSH/oh-my-bash.sh"
fi

# Modern bash-completion requires Bash 4.2+. Keep Apple's Bash 3.2 usable,
# and avoid reloading it if a distro profile or Oh My Bash already loaded it.
if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2) )) &&
    [ -z "${BASH_COMPLETION_VERSINFO:-}" ]; then
    if [ -n "${HOMEBREW_PREFIX:-}" ] && [ -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]; then
        source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
    elif [ -r /usr/share/bash-completion/bash_completion ]; then
        source /usr/share/bash-completion/bash_completion
    elif [ -r /etc/bash_completion ]; then
        source /etc/bash_completion
    fi
fi

unset MAILCHECK
if [ -f "$HOME/.config/shell/fzf.sh" ]; then
    source "$HOME/.config/shell/fzf.sh"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if [ -f "$HOME/.bashrc_after_local" ]; then
    source "$HOME/.bashrc_after_local"
fi
